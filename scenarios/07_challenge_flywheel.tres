[gd_resource type="Resource" script_class="Scenario" load_steps=5 format=3]

[ext_resource type="Script" path="res://core/scenario.gd" id="1_scenario"]
[ext_resource type="Script" path="res://plants/flywheel/flywheel_plant.gd" id="2_plant"]
[ext_resource type="Script" path="res://core/challenge.gd" id="3_challenge"]

[sub_resource type="Resource" id="Resource_challenge"]
script = ExtResource("3_challenge")
goal = "Spin the flywheel from rest to 3000 RPM quickly, without overshooting, and hold it there."
duration_s = 6.0
random_seed = 7
start_level = 0.0
target_level = 314.159
step_time_s = 1.0
specs = Dictionary[String, float]({"overshoot_percent": 5.0, "settling_time_s": 1.0, "steady_state_error": 0.5236})

[resource]
script = ExtResource("1_scenario")
title = "Challenge: flywheel"
notes = "A tuning challenge. Read the goals on the Challenge tab, tune the PID, then press Run test.\nThe test always uses the same seed and setup, so the result depends only on your tuning.\nHint: P alone always stops short. What removes the gap?"
start_mode = 1
plant_script = ExtResource("2_plant")
challenge = SubResource("Resource_challenge")
