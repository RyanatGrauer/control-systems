[ext_resource type="Script" path="res://core/scenario.gd" id="1_scenario"]
[ext_resource type="Script" path="res://plants/servo/servo_plant.gd" id="2_plant"]

[resource]
script = ExtResource("1_scenario")
title = "DC motor position (servo)"
notes = "1. Manual first: point the arm at the ghost. You have to stop the motor exactly on time.\n2. Switch to PID (P only). This time P alone reaches the target with no gap. Why is that different from the flywheel?\n3. P alone rings for a long time. Add Kd to calm it.\n4. Sensor & actuator: turn on Quantization (an encoder) and see how D reacts to the steps in the reading."
start_mode = 0
plant_script = ExtResource("2_plant")
